#!/bin/sh
# First boot defaults. uci-defaults removes this after it succeeds.

# zram swap: half of RAM, lz4 (the A5 cores are slow, ratio matters less
# than speed). Unsupported algorithms are ignored by the init script.
uci -q set system.@system[0].zram_size_mb='512'
uci -q set system.@system[0].zram_comp_algo='lz4'

# Serve time to the LAN as well as sync from upstream.
uci -q set system.ntp.enable_server='1'

uci -q set luci.main.lang='zh_cn'

uci -q commit system
uci -q commit luci

/etc/init.d/irqbalance enable 2>/dev/null

# The OneCloud has a single 100 Mbit port, so WAN has to come from a USB
# NIC or a tethered phone. Pre-create it on eth1; if nothing is plugged in
# the interface simply stays down and the LAN keeps working.
if ! uci -q get network.wan >/dev/null; then
	uci -q set network.wan=interface
	uci -q set network.wan.proto='dhcp'
	uci -q set network.wan.device='eth1'
	uci -q set network.wan.metric='10'
	uci -q set network.wan6=interface
	uci -q set network.wan6.proto='dhcpv6'
	uci -q set network.wan6.device='eth1'
	uci -q set network.wan6.reqaddress='try'
	uci -q set network.wan6.reqprefix='auto'
	uci -q set network.wan6.metric='10'
	uci -q commit network
fi

# Flow offloading is deliberately left off. Software offload moves
# established flows into a flowtable that bypasses the netfilter path,
# which breaks fwmark-based transparent proxying; hardware offload does
# not exist for this SoC's stmmac driver. At 100 Mbit there is nothing to
# gain. The LuCI checkbox still works if you ever want it.

exit 0
