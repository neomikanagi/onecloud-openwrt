#!/bin/sh
# onecloud-install-emmc — Armbian-install analog for OneCloud OpenWrt.
#
# After the box has been line-flashed once (u-boot on eMMC can USB-boot):
#   1. Write the same emmc.img to a USB stick, boot from USB
#   2. Run: onecloud-install-emmc
#      copies running USB p1+p2 onto eMMC p1+p2 (u-boot and data p3 kept)
#
# Or flash a downloaded image while already on eMMC (same as sysupgrade):
#   onecloud-install-emmc /tmp/openwrt-*-emmc.img.gz
#
# Does NOT rewrite Amlogic bootloader. First-time from stock Android still
# needs USB Burning Tool + *.burn.img.

set -e

YES=0
IMG=""
while [ $# -gt 0 ]; do
	case "$1" in
		-y|--yes) YES=1 ;;
		-h|--help)
			sed -n '2,16p' "$0"
			exit 0
			;;
		*) IMG="$1" ;;
	esac
	shift
done

find_emmc() {
	local dev
	for dev in mmcblk1 mmcblk0; do
		[ -b "/dev/$dev" ] || continue
		[ "$(cat /sys/block/$dev/device/type 2>/dev/null)" = "MMC" ] && { echo "$dev"; return 0; }
	done
	return 1
}

root_src=$(awk '$2=="/"{print $1}' /proc/mounts | head -1)
emmc=$(find_emmc) || { echo "ERROR: no eMMC"; exit 1; }

echo "eMMC     : /dev/$emmc"
echo "root src : $root_src"

if [ -n "$IMG" ]; then
	[ -f "$IMG" ] || { echo "ERROR: $IMG not found"; exit 1; }
	echo "image    : $IMG"
	echo "Will sysupgrade p1+p2 from image (u-boot + p3 kept)."
	if [ "$YES" != 1 ]; then
		printf "Type yes to continue: "
		read ans
		[ "$ans" = "yes" ] || exit 1
	fi
	# Reuse platform.sh if present, else invoke sysupgrade
	if [ -x /sbin/sysupgrade ]; then
		sysupgrade -n "$IMG"
	else
		echo "ERROR: sysupgrade missing"
		exit 1
	fi
	exit 0
fi

case "$root_src" in
	/dev/${emmc}p2|/dev/${emmc}p2p*)
		echo "Already running from eMMC. Pass an image to upgrade:"
		echo "  $0 /tmp/xxx-emmc.img.gz"
		exit 1
		;;
esac

src_boot=""
src_root=""
case "$root_src" in
	/dev/sd*[0-9])
		disk=${root_src%%[0-9]*}
		src_boot="${disk}1"
		src_root="${disk}2"
		;;
	/dev/mmcblk0p2)
		src_boot="/dev/mmcblk0p1"
		src_root="/dev/mmcblk0p2"
		;;
	*)
		echo "ERROR: unsupported root $root_src (need USB/SD)"
		exit 1
		;;
esac

echo "copy $src_boot -> /dev/${emmc}p1"
echo "copy $src_root -> /dev/${emmc}p2"
if [ "$YES" != 1 ]; then
	printf "Type yes to continue: "
	read ans
	[ "$ans" = "yes" ] || exit 1
fi

sync
dd if="$src_boot" of="/dev/${emmc}p1" bs=4M conv=fsync status=progress
dd if="$src_root" of="/dev/${emmc}p2" bs=4M conv=fsync status=progress
sync
echo "Done. Power off, unplug USB, boot from eMMC."
