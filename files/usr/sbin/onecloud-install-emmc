#!/bin/sh
# onecloud-install-emmc - write an OpenWrt image to the OneCloud eMMC.
#
# The counterpart of armbian-install. Boot the box from a USB stick (or SD
# card) that was written with the OpenWrt image, then run this to move the
# system onto eMMC.
#
#   onecloud-install-emmc [image.img.gz]
#
# With no argument it looks for an image on the boot partition of the
# medium you are running from.
#
# Only the two partitions declared by the image are written: p1 (FAT boot)
# and p2 (ext4 root). The Amlogic bootloader in front of the partition
# table is never touched, so this cannot brick the box. A device that has
# never been flashed has no bootloader at all and still needs the USB
# Burning Tool with the .burn.img once.

set -e
set -o pipefail

YES=0
IMG=""
while [ $# -gt 0 ]; do
	case "$1" in
	-y|--yes) YES=1 ;;
	-h|--help) sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
	-*) echo "unknown option: $1" >&2; exit 1 ;;
	*) IMG="$1" ;;
	esac
	shift
done

die() { echo "onecloud-install-emmc: $*" >&2; exit 1; }

find_emmc() {
	local dev
	for dev in mmcblk0 mmcblk1 mmcblk2; do
		[ -b "/dev/$dev" ] || continue
		[ "$(cat "/sys/block/$dev/device/type" 2>/dev/null)" = "MMC" ] || continue
		echo "$dev"
		return 0
	done
	return 1
}

uncat() {
	case "$(hexdump -v -n 2 -e '1/1 "%02x"' "$1")" in
	1f8b) gzip -dc "$1" ;;
	*) cat "$1" ;;
	esac
}

emmc=$(find_emmc) || die "no eMMC found"
root_src=$(awk '$2=="/"{print $1; exit}' /proc/mounts)

case "$root_src" in
/dev/${emmc}p*) die "already running from eMMC - use sysupgrade instead" ;;
esac

# No image given: look for one next to the kernel on the medium we booted.
if [ -z "$IMG" ]; then
	mkdir -p /tmp/srcboot
	case "$root_src" in
	/dev/sd*) src_boot="${root_src%2}1" ;;
	/dev/mmcblk*p2) src_boot="${root_src%2}1" ;;
	*) src_boot="" ;;
	esac
	if [ -n "$src_boot" ] && mount -t vfat -o ro "$src_boot" /tmp/srcboot 2>/dev/null; then
		IMG=$(ls /tmp/srcboot/*.img.gz /tmp/srcboot/*.img 2>/dev/null | head -1)
		[ -n "$IMG" ] && cp "$IMG" /tmp/install.img && IMG=/tmp/install.img
		umount /tmp/srcboot
	fi
fi

[ -n "$IMG" ] || die "no image given and none found on the boot partition"
[ -f "$IMG" ] || die "$IMG not found"

# Read the image partition table.
uncat "$IMG" | dd of=/tmp/install.mbr bs=512 count=1 2>/dev/null
[ "$(hexdump -v -n 2 -s 510 -e '1/1 "%02x"' /tmp/install.mbr)" = "55aa" ] ||
	die "$IMG is not a disk image (no MBR signature)"

echo "image  : $IMG"
echo "target : /dev/$emmc"

n=1
while [ $n -le 2 ]; do
	off=$((0x1BE + (n - 1) * 16))
	set -- $(hexdump -v -n 8 -s $((off + 8)) -e '2/4 "%u "' /tmp/install.mbr)
	eval "start$n=$1; size$n=$2"
	[ "$2" -gt 0 ] || die "image partition $n is empty"
	have=$(cat "/sys/class/block/${emmc}p${n}/size" 2>/dev/null || echo 0)
	[ "$have" -gt 0 ] || die "/dev/${emmc}p${n} does not exist - flash the .burn.img first"
	[ "$2" -le "$have" ] ||
		die "image partition $n needs $2 sectors, /dev/${emmc}p${n} only has $have"
	echo "  p$n: $(( $2 / 2048 )) MiB -> /dev/${emmc}p${n}"
	n=$((n + 1))
done

if [ "$YES" != 1 ]; then
	printf "This overwrites the system on eMMC. Type yes to continue: "
	read ans
	[ "$ans" = "yes" ] || exit 1
fi

sync
n=1
while [ $n -le 2 ]; do
	eval "start=\$start$n; size=\$size$n"
	echo "writing p$n ..."
	uncat "$IMG" | dd of="/dev/${emmc}p${n}" ibs=512 obs=1M \
		skip="$start" count="$size" conv=fsync 2>/dev/null
	n=$((n + 1))
done
sync
rm -f /tmp/install.mbr

echo
echo "Done. Power off, remove the USB stick, power on."
