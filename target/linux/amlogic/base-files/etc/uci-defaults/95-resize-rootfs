#!/bin/sh
# The shipped rootfs is only as large as CONFIG_TARGET_ROOTFS_PARTSIZE.
# The real eMMC partition is much bigger, so grow the filesystem into it.
# Runs again after every sysupgrade, which is intended.

. /lib/upgrade/common.sh

export_bootdevice && export_partdevice rootdev 2 || exit 0
[ -b "/dev/$rootdev" ] || exit 0

resize2fs "/dev/$rootdev" >/dev/null 2>&1

exit 0
