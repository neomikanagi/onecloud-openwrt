#!/bin/sh
# Copyright (C) 2024 OpenWrt.org

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
thunder,onecloud)
	ucidef_set_led_netdev "green" "green:status" "green:status" "eth0" "link tx rx"
	ucidef_set_led_heartbeat "blue" "blue:status" "blue:status"
	ucidef_set_led_default "red" "red:status" "red:status" "0"
	;;
esac

board_config_flush

exit 0
