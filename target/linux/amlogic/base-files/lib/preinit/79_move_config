#!/bin/sh
# Pick up the sysupgrade config backup that platform_copy_config left on
# the FAT boot partition.

move_config() {
	local partdev

	. /lib/upgrade/common.sh

	export_bootdevice && export_partdevice partdev 1 || return 0

	mkdir -p /boot
	if mount -t vfat -o rw,noatime "/dev/$partdev" /boot; then
		[ -f "/boot/$BACKUP_FILE" ] && mv -f "/boot/$BACKUP_FILE" /
		umount /boot
	fi
}

boot_hook_add preinit_mount_root move_config
